<Window x:Class="C2SR.Views.SetValueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:C2SR.Views"
        mc:Ignorable="d"
        Title="Set Value" Width="300" Height="350" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Header="Set Value">
            <StackPanel Margin="5">
                <CheckBox x:Name="checkBox_SetMM" Margin="5" HorizontalAlignment="Left" Content="Set Million Master Achieved" VerticalContentAlignment="Center"
                          IsChecked="{Binding SetsMM}"/>
                <CheckBox x:Name="checkBox_MM" Margin="25 5 5 5" HorizontalAlignment="Left" Content="Million Master Achieved" VerticalContentAlignment="Center"
                          IsChecked="{Binding IsMM}" IsEnabled="{Binding SetsMM}"/>
                <CheckBox x:Name="checkBox_SetTP" Margin="5" HorizontalAlignment="Left" Content="Set TP" VerticalContentAlignment="Center"
                          IsChecked="{Binding SetsTP}"/>
                <TextBox x:Name="textBox_TP" Margin="25 5 5 5" Width="100" HorizontalAlignment="Left" HorizontalContentAlignment="Right"
                         Text="{Binding TP}" IsEnabled="{Binding SetsTP}"/>
                <CheckBox x:Name="checkBox_SetMxm" Margin="5" HorizontalAlignment="Left" Content="Set Max Master Achieved" VerticalContentAlignment="Center"
                          IsChecked="{Binding SetsMxm}"/>
                <CheckBox x:Name="checkBox_Mxm" Margin="25 5 5 5" HorizontalAlignment="Left" Content="Max Master Achieved" VerticalContentAlignment="Center"
                          IsChecked="{Binding IsMxm}" IsEnabled="{Binding SetsMxm}"/>
            </StackPanel>
        </GroupBox>
        <Button x:Name="button_OK" Grid.Row="2" Grid.Column="1" Width="75" Height="30" IsDefault="True" Content="OK"
                Click="button_OK_Click"/>
        <Button x:Name="button_Cancel" Grid.Row="2" Grid.Column="3" Width="75" Height="30" IsCancel="True" Content="Cancel"
                Click="button_Cancel_Click"/>
    </Grid>
</Window>
