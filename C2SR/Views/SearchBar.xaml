<UserControl x:Class="C2SR.Views.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:C2SR.Views" 
             xmlns:conv="clr-namespace:C2SR.Converters" 
             xmlns:res="clr-namespace:C2SR.Resources" 
             mc:Ignorable="d" 
             Name="root"
             d:DesignHeight="200" d:DesignWidth="500">
    <UserControl.Resources>
        <conv:SearchOptionToIntConverter x:Key="SearchOptionToIntConverter"/>
    </UserControl.Resources>
    <StackPanel Margin="2" Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
        <ComboBox Margin="4" Width="100" VerticalAlignment="Center"
                  SelectedIndex="{Binding ElementName=root, Path=SearchOption, Converter={StaticResource SearchOptionToIntConverter}}"
                  SelectionChanged="ComboBox_SelectionChanged">
            <ComboBoxItem Content="{x:Static res:Strings.MainWindow_Header_Name}"/>
            <ComboBoxItem Content="{x:Static res:Strings.MainWindow_Header_Artist}"/>
        </ComboBox>
        <TextBox Margin="4" Width="200" VerticalAlignment="Center"
                 Text="{Binding ElementName=root, Path=SearchTerm}"
                 KeyDown="TextBox_KeyDown" LostFocus="TextBox_LostFocus"/>
        <Button Margin="4" Padding="5 2" Content="{x:Static res:Strings.MainWindow_Search}" VerticalAlignment="Center"
                        Click="button_Search_Click"/>
        <CheckBox Margin="4" Content="{x:Static res:Strings.MainWindow_Search_IsCaseSensitive}" VerticalAlignment="Center"
                  IsChecked="{Binding ElementName=root, Path=IsCaseSensitive}"
                  Checked="CheckBox_Checked" Unchecked="CheckBox_Checked"/>
    </StackPanel>
</UserControl>
